# Copy to .env and fill secrets: cp .env.example .env
DJANGO_SECRET_KEY=change-me-to-a-strong-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=webmail.nextstoplabs.org,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://webmail.nextstoplabs.org
CORS_ALLOWED_ORIGINS=https://webmail.nextstoplabs.org

DATABASE_URL=postgres://webmail:webmail@db:5432/webmail
POSTGRES_DB=webmail
POSTGRES_USER=webmail
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0

MAIL_IMAP_HOST=mail.nextstoplabs.org
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURITY=SSL
MAIL_SMTP_HOST=mail.nextstoplabs.org
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURITY=STARTTLS

SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=1209600
